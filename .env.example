# ─────────────────────────────────────────────────────────────────────────
# ARSTEG website environment variables
# Copy to `.env` (or `.env.local`) and fill in. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────────────────

# Postmark — SERVER-ONLY. Used by /api/send-email to deliver enquiries.
# Do NOT prefix these with NEXT_PUBLIC_ (that would leak the key to the browser).
POSTMARK_API_KEY=your-postmark-server-token
POSTMARK_SENDER_EMAIL=noreply@arsteg.com        # must be a verified Postmark sender signature
POSTMARK_RECEIVER_EMAIL=info@arsteg.com         # where enquiries are delivered

# Supabase — the anon key is safe to expose to the browser (protect tables with RLS).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Booking — optional. When set, the "Book a call" UI embeds this Calendly URL.
# When absent, the site falls back to the enquiry form + direct contact (no fake calendar).
NEXT_PUBLIC_CALENDLY_URL=

# Analytics — optional. When set, GA4 loads with IP anonymization; no PII is sent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
